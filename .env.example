# Copy this file to .env and replace every placeholder. Never commit .env.
# Generate a strong local password with:  openssl rand -hex 24

# --- App ports (local development) ---
STOREFRONT_PORT=3000
API_PORT=3001

# --- PostgreSQL (Docker: docker-compose.dev.yml, host port 5433) ---
POSTGRES_DB=jewellery
POSTGRES_USER=jewellery
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://jewellery:replace-with-strong-password@127.0.0.1:5433/jewellery?schema=public

# --- Redis (Docker: docker-compose.dev.yml, host port 6380) ---
REDIS_PASSWORD=replace-with-strong-password
REDIS_PORT=6380
REDIS_URL=redis://:replace-with-strong-password@127.0.0.1:6380/0
