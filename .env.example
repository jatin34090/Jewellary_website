# Copy this file to .env and replace every placeholder. Never commit .env.
# Generate a strong local password with:  openssl rand -hex 24

# --- App ports (local development) ---
STOREFRONT_PORT=3000
API_PORT=3001

# --- PostgreSQL (Docker: docker-compose.dev.yml, host port 5433) ---
POSTGRES_DB=jewellery
POSTGRES_USER=jewellery
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://jewellery:replace-with-strong-password@127.0.0.1:5433/jewellery?schema=public

# --- Redis (Docker: docker-compose.dev.yml, host port 6380) ---
REDIS_PASSWORD=replace-with-strong-password
REDIS_PORT=6380
REDIS_URL=redis://:replace-with-strong-password@127.0.0.1:6380/0

# --- API (NestJS) ---
# Bind address. Keep 127.0.0.1 locally. Use 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
# Generate with:  openssl rand -base64 48   (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-64-char-random-value
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of storefront origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
# Must be true in production (HTTPS only cookies).
COOKIE_SECURE=false
# Swagger UI at /api/v1/docs. Keep false in production.
SWAGGER_ENABLED=true
# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs and rate limits.
TRUST_PROXY_HOPS=0
